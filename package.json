{
  "name": "hanzi-stroke-order",
  "version": "1.0.0",
  "private": true,
  "description": "Chinese character stroke order viewer and quiz",
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target browser --minify",
    "watch": "bun build src/main.ts --outdir dist --target browser --watch",
    "check": "tsc",
    "characters": "bun scripts/characters.ts > src/characters.ts"
  },
  "dependencies": {
    "hanzi-writer": "3.7.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
